{
  "name": "@sumostudio/herdr-sdk",
  "version": "0.8.2-sumostudio.1",
  "description": "Unofficial Effect-native Herdr protocol-20 transport fork for SumoStudio.",
  "homepage": "https://github.com/dhruvkelawala/herdr-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/dhruvkelawala/herdr-ts-sdk/issues"
  },
  "license": "(MIT AND Apache-2.0)",
  "author": "Dillon Mulroy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvkelawala/herdr-ts-sdk.git"
  },
  "files": [
    "dist/src/*.js",
    "dist/src/*.d.ts",
    "dist/src/generated/*.js",
    "dist/src/generated/*.d.ts",
    "dist/schema/herdr-api.schema.json",
    "LICENSE",
    "README.md",
    "PROVENANCE.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/HERDR-APACHE-2.0.txt"
  ],
  "type": "module",
  "main": "./dist/src/herdr-transport.js",
  "types": "./dist/src/herdr-transport.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/herdr-transport.d.ts",
      "import": "./dist/src/herdr-transport.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "sumostudio"
  },
  "scripts": {
    "generate": "bun transport/scripts/generate-wire-types.mjs && oxfmt transport/src/generated",
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt transport scripts/release tests package.json .oxfmtrc.json tsconfig.build.json tsconfig.transport.json oxlint.transport.json README.md PROVENANCE.md THIRD_PARTY_NOTICES.md",
    "format:check": "oxfmt --check transport scripts/release tests package.json .oxfmtrc.json tsconfig.build.json tsconfig.transport.json oxlint.transport.json README.md PROVENANCE.md THIRD_PARTY_NOTICES.md",
    "lint": "oxlint -c oxlint.transport.json transport scripts/release tests",
    "typecheck": "tsc -p tsconfig.transport.json",
    "test": "bun test ./transport ./tests",
    "check": "bun install --frozen-lockfile --dry-run && bun run format:check && bun run lint && bun run build && bun run typecheck && bun run test",
    "verify:package": "bun scripts/release/verify-package.mjs",
    "smoke": "bun scripts/release/read-only-smoke.mjs",
    "prepublishOnly": "bun run check && bun run verify:package"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "ajv": "8.20.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "json-schema-to-typescript": "15.0.4",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": "1.4.0",
    "node": ">=26.10.0"
  },
  "packageManager": "bun@1.4.0",
  "herdr": {
    "protocol": 20,
    "version": "0.8.2",
    "channel": "stable",
    "sdkUpstreamCommit": "2e70f2638c53c5b0d2335f0641a479a0f42fd578"
  },
  "sumostudioRelease": {
    "nodeVersion": "26.10.0",
    "npmVersion": "11.19.1"
  }
}
